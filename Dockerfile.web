# Document OCR + AI Pipeline — web (static frontend) service.
#
# web/static/ is a plain HTML/CSS/JS client of the api/ service (no
# framework, no build step) — this container is just a local-dev preview of
# exactly what gets synced to S3/CloudFront in production, so
# `docker compose up` still gives a working full-stack demo. See
# web/static/config.js for how it finds the API.

FROM python:3.13-slim
RUN useradd -m -u 1000 appuser
WORKDIR /site
COPY --chown=appuser:appuser web/static /site

USER appuser
EXPOSE 8080
CMD ["python", "-m", "http.server", "8080"]
