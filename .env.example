# Copy to .env (gitignored) and fill in for local development.
# docker-compose.yml reads OPENROUTER_API_KEY from the environment.

# Server-side only — never sent to the browser. Get one at https://openrouter.ai/keys
# Optional: the app works without it, degrading gracefully (regex field
# extraction instead of LLM extraction; Q&A/search return a clear 503/message).
OPENROUTER_API_KEY=

# api/ settings (defaults shown)
CORS_ALLOW_ORIGINS=*
MAX_UPLOAD_MB=10
OCR_LANG=eng

# web/ is a static site (web/static/) — it finds the API via
# web/static/config.js, not an environment variable.
