   "source": "m = result['metrics']\nstages = ['Preprocessing', 'Layout Analysis', 'Recognition', 'Post-Processing']\ntimes  = [m['preprocessing_s'], m['layout_analysis_s'],\n          m['recognition_s'],   m['postprocessing_s']]\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# Bar chart\naxes[0].barh(stages[::-1], times[::-1], color='steelblue')\naxes[0].set_xlabel('Time (seconds)')\naxes[0].set_title('Stage-wise Processing Time')\nfor i, (t, s) in enumerate(zip(times[::-1], stages[::-1])):\n    axes[0].text(t + 0.001, i, f'{t:.3f}s', va='center', fontsize=10)\n\n# Pie chart\naxes[1].pie(times, labels=stages, autopct='%1.1f%%',\n            startangle=140, colors=['#4C72B0','#DD8452','#55A868','#C44E52'])\naxes[1].set_title(f'Time Distribution  (total: {m[\"total_s\"]}s)')\n\nplt.suptitle('5.2 OCR Pipeline Timing Breakdown', fontsize=13, fontweight='bold')\nplt.tight_layout(); plt.show()\n\nprint(f\"\\nTotal pipeline time : {m['total_s']} s\")\nprint(f\"Words recognised    : {m['word_count']}\")\nprint(f\"Regions segmented   : {m['region_count']}\")",
