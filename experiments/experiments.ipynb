  {
   "cell_type": "code",
   "id": "4b754712",
   "source": "spell  = SpellCorrector(max_distance=2)\nctx    = ContextVerifier()\n\n# Simulate OCR errors typical of document scans\nraw_ocr_text = (\n    \"INVOI CE #2O24-OO42\\n\"               # 'O' instead of '0'\n    \"Bil1 To: Departrnent of EIE\\n\"       # '1'→'l', 'rn'→'m'\n    \"Datte: 23 lanuary 2026\\n\"            # typo 'Datte', 'l'→'j'\n    \"Tottal Due: LKR 94,OOO.OO\\n\"         # typo 'Tottal', O→0\n)\n\nafter_ctx   = ctx.apply(raw_ocr_text)\nafter_spell = spell.correct_text(after_ctx)\n\nprint(\"=== RAW OCR ===\")\nprint(raw_ocr_text)\nprint(\"=== AFTER CONTEXT VERIFICATION ===\")\nprint(after_ctx)\nprint(\"=== AFTER SPELL CORRECTION ===\")\nprint(after_spell)",
