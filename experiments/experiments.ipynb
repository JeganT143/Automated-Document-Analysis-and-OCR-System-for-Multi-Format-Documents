  {
   "cell_type": "code",
   "id": "af04fd29",
   "source": "# Ground-truth words from the synthetic document\nground_truth = (\n    \"INVOICE 2024-0042 \"\n    \"University of Ruhuna Accounts Dept \"\n    \"Bill To Department of EIE \"\n    \"Date 23 January 2026 \"\n    \"Due Date 07 February 2026 \"\n    \"Payment Method Bank Transfer \"\n    \"Total Due LKR 94000\"\n)\n\nhypothesis = ' '.join(result['words'])\n\ncer = OCRPipeline.compute_cer(ground_truth, hypothesis)\nwer = OCRPipeline.compute_wer(ground_truth, hypothesis)\n\nprint(f\"Character Error Rate (CER) : {cer*100:.2f}%  (target < 10%)\")\nprint(f\"Word Error Rate      (WER) : {wer*100:.2f}%  (target < 15%)\")\nprint()\n\n# IoU demonstration for bounding boxes\nbox_gt   = (100, 200, 300, 50)   # (x, y, w, h)  ground truth\nbox_pred = (110, 205, 290, 48)   # slightly shifted prediction\n\niou = OCRPipeline.compute_iou(box_gt, box_pred)\nprint(f\"IoU for sample bounding boxes: {iou:.4f}\")\n\n# Plot IoU boxes\nfig, ax = plt.subplots(figsize=(5, 3))\nax.add_patch(plt.Rectangle((box_gt[0], box_gt[1]), box_gt[2], box_gt[3],\n             fill=False, edgecolor='green', linewidth=2, label='Ground Truth'))\nax.add_patch(plt.Rectangle((box_pred[0], box_pred[1]), box_pred[2], box_pred[3],\n             fill=False, edgecolor='red',   linewidth=2, linestyle='--', label='Prediction'))\nax.set_xlim(80, 430); ax.set_ylim(180, 270); ax.invert_yaxis()\nax.legend(fontsize=9); ax.set_title(f'IoU = {iou:.4f}')\nplt.tight_layout(); plt.show()\n\n# Bar chart of all metrics\nmetrics_names  = ['CER (%)', 'WER (%)', 'IoU']\nmetrics_vals   = [cer*100, wer*100, iou*100]\ntargets        = [10, 15, 70]\n\nfig, ax = plt.subplots(figsize=(7, 4))\nbars = ax.bar(metrics_names, metrics_vals, color=['steelblue', 'coral', 'mediumseagreen'])\nfor bar, tgt, val in zip(bars, targets, metrics_vals):\n    ax.axhline(tgt, color='red', linestyle='--', alpha=0.5)\n    ax.text(bar.get_x() + bar.get_width()/2, val + 0.5, f'{val:.1f}', ha='center', fontweight='bold')\nax.set_ylabel('Value (%)')\nax.set_title('5.1 Evaluation Metrics Summary')\nplt.tight_layout(); plt.show()",
