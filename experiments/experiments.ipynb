   "source": "assembler = WordAssembler(word_gap_factor=1.5, line_gap_factor=2.0)\n\n# Try Tesseract for ground-truth labels; fall back to placeholder chars\ntry:\n    import pytesseract\n    pytesseract.get_tesseract_version()\n    tess_text = pytesseract.image_to_string(deskewed_gray, config='--oem 3 --psm 6')\n    print(\"Using Tesseract for reference labels.\")\nexcept Exception:\n    tess_text = \"invoice bill date total due department address number january february\"\n    print(\"Tesseract not found – using placeholder vocabulary for demo.\")\n\nchar_labels = list(tess_text.replace('\\n', ' ').replace('  ', ' '))\nchar_labels = [c for c in char_labels if c.strip()]\n\n# Pad or trim to match component count\nn = len(filtered_comps)\nchar_labels = (char_labels * (n // max(len(char_labels), 1) + 1))[:n] if char_labels else ['?'] * n\n\nwords = assembler.assemble(filtered_comps, char_labels)\n\nprint(f\"Components  : {len(filtered_comps)}\")\nprint(f\"Words found : {len(words)}\")\nprint()\nprint(\"Assembled words (first 40):\")\nprint(' | '.join(words[:40]))",
