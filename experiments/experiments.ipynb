   "cell_type": "markdown",
   "id": "ea0a1987",
   "source": "### 3.4 Template Matching Fallback\n\nWhen classifier confidence < threshold, template matching uses normalised cross-correlation to find the best-matching stored template.",
   "metadata": {}
  },
  {
   "cell_type": "code",
   "id": "b3879521",
   "source": "tm = TemplateMatcher()\n\n# Register one template per digit using the first occurrence in the dataset\ndigit_images = (digits.images * 16).astype(np.uint8)\nfor cls in range(10):\n    idx = np.where(digits.target == cls)[0][0]\n    img_32 = cv2.resize(digit_images[idx], (32, 32))\n    tm.add_template(str(cls), img_32)\n\n# Test template matching on 20 examples\ncorrect = 0\nn_test  = 40\nfor i in range(n_test):\n    query_img = cv2.resize(digit_images[-(i+1)], (32, 32))\n    true_label = str(digits.target[-(i+1)])\n    pred_label, score = tm.match(query_img)\n    if pred_label == true_label:\n        correct += 1\n\nprint(f\"Template matching accuracy (n={n_test}): {correct/n_test*100:.1f}%\")\nprint(\"(Single template per class – accuracy improves with more templates)\")\n\n# Visual: query vs best match\nfig, axes = plt.subplots(2, 5, figsize=(12, 5))\nfor i, ax_pair in enumerate(axes.T):\n    query = cv2.resize(digit_images[-(i+1)], (32, 32))\n    pred, score = tm.match(query)\n    # retrieve the matched template image\n    tmpl_img = tm.templates[pred][0] if pred and pred in tm.templates else np.zeros((32,32), np.uint8)\n    ax_pair[0].imshow(query, cmap='gray'); ax_pair[0].set_title(f'Query: {digits.target[-(i+1)]}', fontsize=9); ax_pair[0].axis('off')\n    ax_pair[1].imshow(tmpl_img, cmap='gray'); ax_pair[1].set_title(f'Match: {pred} ({score:.2f})', fontsize=9); ax_pair[1].axis('off')\nplt.suptitle('3.4 Template Matching (query → best template)', fontsize=12, fontweight='bold')\nplt.tight_layout(); plt.show()",
   "metadata": {},
