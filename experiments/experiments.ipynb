   "source": "fmt  = OutputFormatter()\npost = PostProcessor()\n\n# Use tess_text from previous cell; fall back gracefully\nsample_words = tess_text.split()[:30] if tess_text else ['invoice', 'total', 'date', 'amount', 'due']\n\ntxt_out  = post.format_output(sample_words, fmt='txt')\njson_out = post.format_output(sample_words, fmt='json')\ncsv_out  = post.format_output(sample_words, fmt='csv')\n\nprint(\"── TXT output ──────────────────────────────────\")\nprint(txt_out[:300])\nprint(\"\\n── JSON output (truncated) ─────────────────────\")\nprint(json_out[:500])\nprint(\"\\n── CSV output (first 5 rows) ────────────────────\")\nprint('\\n'.join(csv_out.split('\\n')[:6]))",
